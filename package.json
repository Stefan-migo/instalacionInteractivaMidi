{
  "name": "interactive-collage",
  "version": "1.0.0",
  "description": "Phone-sensor-controlled collage installation on a shared 1920x1080 canvas",
  "main": "bridge/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node bridge/index.js",
    "bridge": "node bridge/index.js",
    "agent": "node music/agent.js",
    "simulate": "node scripts/simulate-phones.js",
    "generate-layout": "node scripts/generate-layout.js"
  },
  "keywords": [
    "installation",
    "collage",
    "p5js",
    "websocket",
    "phone-sensors"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@julusian/midi": "3.8.1"
  },
  "allowScripts": {
    "@julusian/midi@3.8.1": true
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
