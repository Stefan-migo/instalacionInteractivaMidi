# Template for the agent's local configuration.
#
# Copy this file to `.env` in the project root and edit the values there:
#   Git Bash:    cp agent.env.example .env
#   PowerShell:  Copy-Item agent.env.example .env
#
# `.env` is in .gitignore, so the copied file never reaches the repository.
# Run the agent with:  node --env-file=.env music/agent.js

# The bridge this agent talks to.
# Deployed:  wss://<your-app>.onrender.com
# Local:     ws://localhost:8080
BRIDGE_URL=wss://TU-APP.onrender.com

# Name of the virtual MIDI port exactly as loopMIDI shows it.
# The Ableton Set binds to the device, not to this name: if you rename it here,
# re-check the mapping in Live.
MIDI_PORT=Collage-MIDI

# How often the bridge pings a silent client before dropping it, in milliseconds.
# HEARTBEAT_MS=30000
